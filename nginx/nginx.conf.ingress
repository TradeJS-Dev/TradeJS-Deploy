worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    resolver 127.0.0.11 ipv6=off valid=30s;

    # The dedicated ingress network reserves this address for Caddy.
    set_real_ip_from 172.30.241.2;
    real_ip_header X-Forwarded-For;

    map $realip_remote_addr $from_caddy {
        default 0;
        172.30.241.2 1;
    }

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log;

    client_max_body_size 10m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    server {
        listen 172.30.241.3:80;
        server_name tradejs.dev;

        if ($from_caddy = 0) {
            return 403;
        }

        if ($request_uri ~* "(think\\\\app\\\\invokefunction|call_user_func_array|pearcmd|md5|<\\?php|<\\?echo|\\.\\./\\.\\./|phpunit|eval-stdin|autodiscover|wp-login|xmlrpc|\\.env|\\.git|composer\\.json|passwd)") {
            return 403;
        }

        location / {
            set $site_upstream site:3003;
            proxy_pass http://$site_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;

            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        }

        location ~ \.php$ {
            return 403;
        }
    }

    server {
        listen 172.30.241.3:80;
        server_name app.tradejs.dev;

        if ($from_caddy = 0) {
            return 403;
        }

        if ($request_uri ~* "(think\\\\app\\\\invokefunction|call_user_func_array|pearcmd|md5|<\\?php|<\\?echo|\\.\\./\\.\\./|phpunit|eval-stdin|autodiscover|wp-login|xmlrpc|\\.env|\\.git|composer\\.json|passwd)") {
            return 403;
        }

        location = /mcp {
            set $mcp_upstream app:3000;
            proxy_pass http://$mcp_upstream;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header Authorization $http_authorization;
            proxy_buffering off;
            proxy_read_timeout 120s;
            client_max_body_size 64k;
        }

        location / {
            set $app_upstream app:3000;
            proxy_pass http://$app_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;

            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        }

        location = /ws/market {
            set $market_ws_upstream app:3001;
            proxy_pass http://$market_ws_upstream;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_read_timeout 75s;
        }

        location ~ \.php$ {
            return 403;
        }
    }

    server {
        listen 172.30.241.3:80;
        server_name redisinsight.tradejs.dev;

        if ($from_caddy = 0) {
            return 403;
        }

        location / {
            auth_basic "Restricted";
            auth_basic_user_file /etc/nginx/tradejs/.htpasswd;

            proxy_pass http://redis:8001;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_redirect off;

            add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        }

        location ~ \.php$ {
            return 403;
        }
    }

    server {
        listen 172.30.241.3:80;
        server_name docs.tradejs.dev;

        if ($from_caddy = 0) {
            return 403;
        }

        location / {
            set $docs_upstream docs:80;
            proxy_pass http://$docs_upstream;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
        }

        location ~ \.php$ {
            return 403;
        }
    }
}
